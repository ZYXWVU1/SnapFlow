        "description": null
      },
      {
        "id": "position",
        "label": "Position",
        "type": "string",
        "required": true,
        "description": null
      },
      {
        "id": "location",
        "label": "Location",
        "type": "string",
        "required": false,
        "description": null
      },
      {
        "id": "salary",
        "label": "Salary",
        "type": "string",
        "required": false,
        "description": null
      },
      {
        "id": "requirements",
        "label": "Requirements",
        "type": "list_string",
        "required": false,
        "description": null
      },
      {
        "id": "deadline",
        "label": "Deadline",
        "type": "date",
        "required": false,
        "description": null
      },
      {
        "id": "url",
        "label": "URL",
        "type": "url",
        "required": false,
        "description": null
      }
    ],
    "actions": [
      "copy_json",
      "copy_markdown",
      "save_csv",
      "ask_ai"
    ],
    "enabled": false,
    "version": 1
  }
