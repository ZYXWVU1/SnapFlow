AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1
# For SiliconFlow, use a vision model and this endpoint instead:
# AI_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_IMAGE_DETAIL=low
# AI_TIMEOUT=600  # seconds; maximum supported value
# AI_MAX_TOKENS=1024
# Only set this to true for a SiliconFlow model that explicitly supports it:
# AI_ENABLE_THINKING=true

# Google OAuth Desktop app credentials for sign-in when running from source.
# Windows bundles receive these values from the build process environment.
SNAPFLOW_GOOGLE_CLIENT_ID=
SNAPFLOW_GOOGLE_CLIENT_SECRET=
